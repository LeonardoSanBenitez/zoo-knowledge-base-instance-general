# Tool invocation logs. These live at ../assets/ (outside this repo, renamed
# from ../.kb-logs/ 2026-09-14) and are never committed anywhere. Listed here
# anyway in case anyone ever relocates the log root into the repo by mistake
# -- see ../tools/README.md.
assets/
*.kblog.jsonl

__pycache__/
*.pyc
.ipynb_checkpoints/

# Heavy assets are registered with ../tools/assets.py, never stored here.
*.zip
*.tar.gz
*.parquet
*.sqlite
